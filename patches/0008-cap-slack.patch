     /// 设下限后满位训练保留副属性的部分计价，分流激励主体仍由 `cap_discount_weight` 承担。
     pub cap_discount_floor: f32,
+    /// 上限期权计价余量（fanfix 0008）：`status_gain` 计价时把上限视为 `limit + cap_slack`。
+    /// 对应真实机制：Y2 basic 上限 +20、Y3 +40（status_limit 抬升）——满位附近训练按
+    /// 「上限将抬」的期权价计费。实际入账仍由游戏 `.min(limit)` 截断，只影响选择不改真实收益。
+    /// `0`（默认）= 旧行为逐位保留。
+    pub cap_slack: i32,
     /// 训练失败惩罚（期望值中被扣减的固定分）
     pub failure_penalty: f32,
     /// Whether policy scoring applies ramen_basic_effect.fail_rate_drop.
@@ -189,6 +194,7 @@ impl Default for RamenPolicyConfig {
             pt_rate: 8.0,
             cap_discount_weight: 0.0,
             cap_discount_floor: 0.0,
+            cap_slack: 0,
             failure_penalty: 60.0,
             effective_ramen_failure: true,
             shining_bonus: 60.0,
@@ -918,7 +924,10 @@ impl RamenPolicy {
         // `inc` 取 i32：负值若直接 `as usize` 会回绕成天文数字，debug 下加法直接溢出 panic。
         // 当前训练增量恒为正打不到，这里显式夹到 0 以免将来引入负增量时静默炸掉。
         let cur = game.uma.five_status[i].min(game.uma.five_status_limit[i]).max(0);
-        let next = cur.saturating_add(inc.max(0)).min(game.uma.five_status_limit[i]);
+        // 上限期权（fanfix 0008）：计价上限 = limit + cap_slack（默认 0=逐位不变）。
+        // 游戏实际入账仍按 limit 截断；此处只抬「选择层」的计价视野，不虚构真实收益。
+        let price_limit = game.uma.five_status_limit[i] + self.config.cap_slack.max(0);
+        let next = cur.saturating_add(inc.max(0)).min(price_limit);
         let cur_score = cons.status_final_score(cur) as f32;
         let next_score = cons.status_final_score(next) as f32;
         (next_score - cur_score) * self.config.status_rate
